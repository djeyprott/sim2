  "gatherers": [ "Farmer" ],
  "dryRainMm": 600,
  "goods": [
    {
      "good": "Wood", "perPerson": 0.5,
      "biomes": { "Boreal forest": 1.0, "Temperate forest": 1.0, "Tropical seasonal forest": 1.0, "Rainforest": 1.0,
