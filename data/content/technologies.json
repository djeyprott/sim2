// Technologies (milestone 3). Population groups hold, for each technology, the share of their
// people who know it; a group uses a technology when that share is at least technology.json's
// "inUse" (technology.json in this folder holds the shared numbers).
//
// For each technology:
//   occupations   who can discover and use it (others never learn it)
//   requires      technologies the group must already use
//   river         the cell must be on a river (true) / climate: dry, at most maxRainMm a year
//   coast         the cell must touch the sea
//   terrain       the cell's terrain must be one of these
//   animals       the cell must keep at least one of these animals (livestock.json)
//   nearGoods     for discovery only: one of these goods can be gathered in the cell or is in
//                 its settlement's store (once known, it spreads without them)
//   nearWild      for discovery only: one of these animals lives wild in the cell (livestock.json
//                 homelands); an animal "tamedBy" this technology is then kept there
//   settledYears  for discovery only: farming has stood in the cell or a neighbour at least this
//                 long. Most of this know-how came to long-settled farmers: farming began about
//                 9500 BCE, so a technology first seen in year Y BCE gets about 9500 - Y - 500
//                 (less for rarer ones, which take longer to be found once possible). Without it,
//                 every technology was found 2,000 to 4,500 years too early (milestone 3 step 8).
//   chance        a group's yearly chance of discovering it, when the conditions are met and the
//                 people in reach (its cell and the neighbouring cells) number at least
//                 technology.json's "discoveryPeople"; smaller in reach, smaller chance
//   spread        how readily it passes to groups in neighbouring cells (a share of the gap a year)
//   history       where and when it was first seen in the real record (for reference only;
//                 see docs/milestone-3-spec.md, "Sources for the dates")
//   effects       what it changes where a group uses it (at least "inUse" of its people know it
//                 and its cell meets the conditions above); the same effect from two technologies
//                 multiplies:
//                   farmYield         multiplies what farmland feeds (farmers' technology)
//                   biomePenaltyLift  share (0 to 1) of farming.json's biome penalty lifted
//                   grainSpoilage     multiplies grain spoilage in the settlement's store
//                   herdDensity       multiplies the herders pasture feeds (herders' technology)
//                   wool              multiplies the wool herders and farmers bring in
//                   herderSpread      multiplies herders' yearly chance of moving onto new pasture
//                   landCarrying      multiplies the cost of carrying goods over land, on trade
//                                     links where both settlements use it (trade.json)
//                   seaRange          sea cells in a row people's boats can cross, for trade
//                                     links (trade.json) and settling new land (seafaring.json);
//                                     the largest known counts, paddling (trade.json) without
//                   seaCost           the cost of carrying goods across a sea cell, against 1 for
//                                     a cell of lowland; the smallest known counts
// Copper working and bronze have no effects listed here: they open recipes (recipes.json); horse
// herding has none either: it brings horses (livestock.json).
// Effect sizes are first estimates, tuned in milestone 3 step 8.
{
  "technologies": [
    {
      "name": "Granaries", "colour": "#d9b26a", "occupations": [ "Farmer" ],
      "chance": 0.0002, "spread": 0.02,
      // Sealed, raised stores keep out damp and pests: grain loses less each year (0.5 and 0.7 left famine
      // too rare once granaries were found, as in history, by about 9500 BCE).
      "effects": { "grainSpoilage": 0.8 },
      "history": "9500 BCE, Jordan valley"
    },
    {
      "name": "Irrigation", "colour": "#4fa3d9", "occupations": [ "Farmer" ],
      "river": true, "maxRainMm": 600,
      "chance": 0.00002, "spread": 0.01,
      "settledYears": 2000,
      // Canals carry river water across dry fields beyond the flood plain.
      "effects": { "farmYield": 1.5 },
      "history": "6000 BCE, Mesopotamia"
    },
    {
      "name": "Milk and wool", "colour": "#f0ecd8", "occupations": [ "Herder", "Farmer" ],
      "animals": [ "Sheep and goats", "Cattle" ],
      "chance": 0.00001, "spread": 0.015,
      "settledYears": 2500,
      // Milk feeds people from the living herd (more people per head than meat alone), and
      // woolly sheep give far more fibre than hair sheep.
      "effects": { "herdDensity": 1.4, "wool": 2.0 },
      "history": "milk 6500 BCE, Anatolia; wool 4000 BCE, Southwest Asia"
    },
    {
      "name": "The plough", "colour": "#a0662f", "occupations": [ "Farmer" ],
      "animals": [ "Cattle" ],
      "chance": 0.00001, "spread": 0.01,
      "settledYears": 4000,
      // Oxen break more land and heavier soils, and the plough cuts the root mats of open grassland.
      "effects": { "farmYield": 1.25, "biomePenaltyLift": 1.0 },
      "history": "5000 BCE, the Alps; early 4th millennium BCE, northern Mesopotamia"
    },
    {
      "name": "The wheel", "colour": "#c0392b", "occupations": [ "Farmer", "Herder" ],
      "requires": [ "The plough" ], "animals": [ "Cattle" ],
      "chance": 0.00005, "spread": 0.015,
      "settledYears": 5500,
      // Ox carts carry loads over land far more cheaply than people and pack animals.
      "effects": { "landCarrying": 0.7 },
      "history": "3500 BCE, Mesopotamia and the steppe"
    },
    {
      "name": "The sail", "colour": "#ecf0f1", "occupations": [ "Farmer", "Craftsman" ],
      "coast": true,
      "chance": 0.000006, "spread": 0.01,
      "settledYears": 2500,
      // Sailing boats cross a few hundred km of open sea, and carry loads more cheaply than land.
      "effects": { "seaRange": 8, "seaCost": 0.4 },
      "history": "5500 to 5000 BCE, the Gulf; 3500 BCE, the Nile"
    },
    {
      "name": "Outrigger canoes", "colour": "#16a085", "occupations": [ "Farmer", "Craftsman" ],
      "requires": [ "The sail" ], "coast": true,
      "chance": 0.000002, "spread": 0.01,
      "settledYears": 7000,
      // Stable sailing canoes that cross thousands of km of open ocean to remote islands.
      "effects": { "seaRange": 50, "seaCost": 0.4 },
      "history": "1500 BCE, Island Southeast Asia"
    },
    {
      "name": "Terraced fields", "colour": "#7cb342", "occupations": [ "Farmer" ],
      "terrain": [ "hills", "mountains" ],
      "chance": 0.000015, "spread": 0.01,
      "settledYears": 5000,
      // Terraces hold soil and water on slopes that would otherwise wash away.
      "effects": { "farmYield": 1.3 },
      "history": "3000 BCE, several places"
    },
    {
      // Smelting copper from its ores, and casting and hammering copper tools.
      "name": "Copper working", "colour": "#c87533", "occupations": [ "Craftsman", "Farmer" ],
      "nearGoods": [ "Copper ore" ],
      "chance": 0.0001, "spread": 0.02,
      "settledYears": 2800,
      "history": "5000 BCE, Balkans (Belovode); perhaps soon after 6000 BCE in northern Iraq"
    },
    {
      // Alloying copper with tin.
      "name": "Bronze", "colour": "#cd9b42", "occupations": [ "Craftsman", "Farmer" ],
      "requires": [ "Copper working" ], "nearGoods": [ "Tin" ],
      "chance": 0.0003, "spread": 0.01,
      "settledYears": 2500,
      "history": "3300 to 3000 BCE, Southwest Asia and the Balkans"
    },
    {
      // Keeping horses for meat and milk where they roamed wild. Found by herders and farmers on
      // the steppe (foragers where horses are kept then take up herding, as with any herd).
      "name": "Horse herding", "colour": "#7a5230", "occupations": [ "Herder", "Farmer" ],
      // Botai's people milked their mares: horses were kept by herders who already milked their herds.
      "requires": [ "Milk and wool" ], "nearWild": [ "Horses" ],
      "chance": 0.000003, "spread": 0.015,
      "history": "3500 BCE, Botai (northern Kazakhstan)"
    },
    {
      // Riding: herders move their herds far faster, and pack and riding horses carry goods.
      "name": "Horse riding", "colour": "#b5651d", "occupations": [ "Herder", "Farmer" ],
      "requires": [ "Horse herding" ], "animals": [ "Horses" ],
      "chance": 0.000001, "spread": 0.02,
      "effects": { "herderSpread": 2.0, "landCarrying": 0.85 },
      "history": "2200 BCE, widespread from the Pontic-Caspian steppe (earlier riding debated)"
    }
  ]
}
