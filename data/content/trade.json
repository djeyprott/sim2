// Trade (milestone 2, step 5).
// Links: each settlement links to the linksPerSettlement settlements it can reach most cheaply
// over land, within maxLinkCost. Crossing one cell costs 1 on lowland, more on hills and
// mountains, and riverFactor times as much where both cells are on a river (a cell is about
// 51 km). Seas and lakes are not crossed. A link counts if either end chose it.
// Trade: each season (every three months), along each link, a good moves from the cheaper end
// to the dearer end if the price gap is larger than the carrying cost (the good's weight times
// costPerStep food for each unit of link cost). The cheaper end sends sendShare of its stock of
// that good each season, shared among its links and scaled down when the gap only just beats
// the cost. Goods arrive the next season.
// A trade route is a link whose carried value (in food) averages at least routeValue a season.
{
  "maxLinkCost": 4.0,
  "linksPerSettlement": 6,
  "terrainCost": { "lowland": 1.0, "hills": 1.6, "mountains": 3.0 },
  "riverFactor": 0.5,
  "costPerStep": 0.02,
  // Food sends this share each season; other goods move once a year (January) and send what
  // four seasons of it would, 1 - (1 - sendShare)^4.
  "sendShare": 0.15,
  "routeValue": 0.2,

  // Links are rebuilt every this many years (in January), around settlements founded or
  // abandoned since; a new settlement may wait that long to be linked.
  "rebuildYears": 5,

  // A good moves only when the dear end's price beats the cheap end's plus the carrying cost by at
  // least this share of the dear price: traders want a margin, and without one goods shuffled back
  // and forth over tiny gaps (590 million sends in 5,000 years).
  "minMargin": 0.05
}
